.jtl-root {
    --jtl-bg: #0E0E10;
    --jtl-surface: #151518;
    --jtl-raised: #1C1C20;
    --jtl-raised-hover: #232329;
    --jtl-raised-pressed: #121215;
    --jtl-field-bg: #111114;
    --jtl-field-bg-focus: #13161A;
    --jtl-field-bg-disabled: #101012;
    --jtl-row-active: #121216;
    --jtl-border: #26262B;
    --jtl-border-strong: #33333A;
    --jtl-border-hover: #43434C;
    --jtl-text: #F2F2F3;
    --jtl-text-secondary: #9A9AA3;
    --jtl-text-muted: #66666E;
    --jtl-text-on-accent: #FFFFFF;
    --jtl-accent: #5C8CC2;
    --jtl-accent-strong: #3E6B9D;
    --jtl-accent-strong-border: #4C7DB5;
    --jtl-accent-hover: #48789F;
    --jtl-accent-pressed: #345C89;
    --jtl-accent-border: #33506F;
    --jtl-accent-surface: #1A2430;
    --jtl-success: #5CA872;
    --jtl-success-border: #2C4A38;
    --jtl-success-surface: #14201A;
    --jtl-warning: #C9973F;
    --jtl-warning-border: #4A3A1E;
    --jtl-warning-surface: #231D12;
    --jtl-error: #CF5F59;
    --jtl-error-border: #4A2725;
    --jtl-error-surface: #241719;
    --jtl-danger-fill: #8E3A35;
    --jtl-danger-border: #A5443E;
    --jtl-danger-hover: #9E4039;
    --jtl-danger-pressed: #7A3029;
    --jtl-switch-off: #2A2A31;
    --jtl-switch-knob-off: #8A8A93;
    --jtl-scrollbar: #2E2E35;
    --jtl-font-size-title: 20px;
    --jtl-font-size-card: 15px;
    --jtl-font-size-body: 13px;
    --jtl-font-size-secondary: 12px;
    --jtl-font-size-caption: 11px;
    --jtl-radius-badge: 4px;
    --jtl-radius-field: 6px;
    --jtl-radius-card: 8px;
    --jtl-radius-toggle: 9px;
    --jtl-space-1: 4px;
    --jtl-space-2: 8px;
    --jtl-space-3: 12px;
    --jtl-space-4: 16px;
    --jtl-space-6: 24px;
    --jtl-height-toggle: 18px;
    --jtl-height-compact: 24px;
    --jtl-height-control: 28px;
    --jtl-height-row: 32px;
    --jtl-height-top-bar: 44px;
    --jtl-height-status-bar: 28px;
    --jtl-sidebar-width: 220px;
    --jtl-sidebar-width-collapsed: 52px;
    --jtl-label-width: 190px;
    --jtl-label-width-card: 150px;
}

.jtl-root {
    flex-grow: 1;
    flex-direction: row;
    min-width: 0;
    background-color: var(--jtl-bg);
    color: var(--jtl-text);
    font-size: 13px;
    -unity-font-style: normal;
}

.jtl-root .unity-label {
    color: var(--jtl-text);
    margin: 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-left;
}
