<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:jtl="JTLStudio.SDK.Editor.Toolkit.Components">
    <ui:VisualElement class="jtl-column jtl-vstack-16">
        <jtl:SectionHeader title-key="configurations.title" description-key="configurations.description">
            <jtl:ToolkitButton name="new-configuration" text-key="configurations.newConfiguration" icon="plus" trailing-icon="chevron-down" />
        </jtl:SectionHeader>
        <ui:VisualElement class="jtl-row jtl-row--stretch jtl-hstack-12">
            <jtl:Card name="yandex-card" active="true" class="jtl-basis">
                <ui:VisualElement class="jtl-row jtl-hstack-10">
                    <jtl:PortalMark portal="yandex" size="24" />
                    <ui:Label text="Yandex Games" class="jtl-text jtl-text--title" />
                    <jtl:Badge text-key="badge.active" variant="success" />
                </ui:VisualElement>
                <jtl:LocalizedLabel key="configurations.yandexDescription" class="jtl-text--secondary jtl-text--wrap" />
                <ui:VisualElement class="jtl-table">
                    <ui:VisualElement class="jtl-table__row jtl-table__row--head">
                        <jtl:LocalizedLabel key="configurations.defineSymbol" class="jtl-text--secondary jtl-grow" />
                        <ui:Label text="JTLSDK_YANDEX_GAMES" class="jtl-text--small jtl-mono" />
                        <jtl:IconButton icon="copy" size="22" class="jtl-ml-4" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-table__row">
                        <jtl:LocalizedLabel key="configurations.compressionFormat" class="jtl-text--secondary jtl-grow" />
                        <ui:Label text="Gzip" class="jtl-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-table__row">
                        <jtl:LocalizedLabel key="configurations.languages" class="jtl-text--secondary jtl-grow" />
                        <jtl:LocalizedLabel key="configurations.yandexLanguages" class="jtl-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="jtl-row">
                    <jtl:ToolkitButton name="open-configuration" text-key="configurations.openConfiguration" block="true" />
                </ui:VisualElement>
            </jtl:Card>
            <jtl:Card name="youtube-card" class="jtl-basis">
                <ui:VisualElement class="jtl-row jtl-hstack-10">
                    <jtl:PortalMark portal="youtube" size="24" />
                    <ui:Label text="YouTube Playables" class="jtl-text jtl-text--title" />
                    <jtl:Badge text-key="badge.inactive" variant="neutral" />
                </ui:VisualElement>
                <jtl:LocalizedLabel key="configurations.youtubeDescription" class="jtl-text--secondary jtl-text--wrap" />
                <ui:VisualElement class="jtl-table">
                    <ui:VisualElement class="jtl-table__row jtl-table__row--head">
                        <jtl:LocalizedLabel key="configurations.defineSymbol" class="jtl-text--secondary jtl-grow" />
                        <ui:Label text="JTLSDK_YOUTUBE_PLAYABLES" class="jtl-text--small jtl-mono" />
                        <jtl:IconButton icon="copy" size="22" class="jtl-ml-4" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-table__row">
                        <jtl:LocalizedLabel key="configurations.compressionFormat" class="jtl-text--secondary jtl-grow" />
                        <ui:Label text="Disabled" class="jtl-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-table__row">
                        <jtl:LocalizedLabel key="configurations.languages" class="jtl-text--secondary jtl-grow" />
                        <jtl:LocalizedLabel key="configurations.youtubeLanguages" class="jtl-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="jtl-row">
                    <jtl:ToolkitButton name="make-active" text-key="configurations.makeActive" block="true" />
                </ui:VisualElement>
            </jtl:Card>
        </ui:VisualElement>
        <jtl:Card title-key="configurations.generalSettings" description-key="configurations.generalDescription" spacing="12">
            <jtl:FieldRow label-key="configurations.initializationTimeout" help-key="configurations.initializationTimeoutHelp" label-width="190">
                <jtl:NumberFieldWithUnit value="10" unit-key="unit.seconds" width="110" />
            </jtl:FieldRow>
            <jtl:FieldRow label-key="configurations.autosaveDelay" help-key="configurations.autosaveDelayHelp" label-width="190">
                <jtl:NumberFieldWithUnit value="3" unit-key="unit.seconds" width="110" />
            </jtl:FieldRow>
            <jtl:FieldRow label-key="configurations.loggingLevel" label-width="190">
                <jtl:Dropdown choices-key="configurations.loggingLevels" selected="1" width="220" />
            </jtl:FieldRow>
        </jtl:Card>
    </ui:VisualElement>
</ui:UXML>
