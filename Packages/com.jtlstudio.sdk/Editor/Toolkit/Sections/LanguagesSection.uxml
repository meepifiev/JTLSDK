<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:jtl="JTLStudio.SDK.Editor.Toolkit.Components">
    <ui:VisualElement class="jtl-column jtl-vstack-16">
        <jtl:SectionHeader title-key="languages.title" description-key="languages.description" />
        <ui:VisualElement class="jtl-row jtl-row--start jtl-hstack-12">
            <jtl:Card title-key="languages.projectLanguages" caption-key="languages.selectedCount" spacing="12" class="jtl-basis">
                <ui:VisualElement name="language-grid" class="jtl-language-grid" />
                <jtl:FieldRow label-key="languages.default" label-width="150">
                    <jtl:Dropdown choices-key="languages.defaultChoices" selected="0" width="220" />
                </jtl:FieldRow>
            </jtl:Card>
            <ui:VisualElement class="jtl-column jtl-vstack-12" style="width: 470px; flex-shrink: 0;">
                <jtl:Card title-key="languages.replacements">
                    <jtl:LocalizedLabel key="languages.replacementsNote" class="jtl-text--caption jtl-text--wrap" style="margin-top: -4px;" />
                    <ui:VisualElement class="jtl-table">
                        <ui:VisualElement class="jtl-table__row jtl-table__row--head">
                            <ui:VisualElement class="jtl-table__cell jtl-table__cell--grow jtl-hstack-6">
                                <jtl:Icon icon="languages" size="14" tone="muted" />
                                <jtl:LocalizedLabel key="language.Belarusian" class="jtl-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell" style="width: 20px;">
                                <ui:Label text="→" class="jtl-text jtl-text--muted" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell" style="width: 110px;">
                                <jtl:LocalizedLabel key="language.Russian" class="jtl-text jtl-text--secondary" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell jtl-table__cell--last">
                                <jtl:IconButton icon="close" size="24" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="jtl-table__row">
                            <ui:VisualElement class="jtl-table__cell jtl-table__cell--grow jtl-hstack-6">
                                <jtl:Icon icon="languages" size="14" tone="muted" />
                                <jtl:LocalizedLabel key="language.Kazakh" class="jtl-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell" style="width: 20px;">
                                <ui:Label text="→" class="jtl-text jtl-text--muted" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell" style="width: 110px;">
                                <jtl:LocalizedLabel key="language.Russian" class="jtl-text jtl-text--secondary" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell jtl-table__cell--last">
                                <jtl:IconButton icon="close" size="24" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="jtl-table__row">
                            <ui:VisualElement class="jtl-table__cell jtl-table__cell--grow jtl-hstack-6">
                                <jtl:Icon icon="languages" size="14" tone="muted" />
                                <jtl:LocalizedLabel key="language.Ukrainian" class="jtl-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell" style="width: 20px;">
                                <ui:Label text="→" class="jtl-text jtl-text--muted" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell" style="width: 110px;">
                                <jtl:LocalizedLabel key="language.Russian" class="jtl-text jtl-text--secondary" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell jtl-table__cell--last">
                                <jtl:IconButton icon="close" size="24" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="jtl-table__row">
                            <ui:VisualElement class="jtl-table__cell jtl-table__cell--grow jtl-hstack-6">
                                <jtl:Icon icon="languages" size="14" tone="muted" />
                                <jtl:LocalizedLabel key="language.Uzbek" class="jtl-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell" style="width: 20px;">
                                <ui:Label text="→" class="jtl-text jtl-text--muted" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell" style="width: 110px;">
                                <jtl:LocalizedLabel key="language.Russian" class="jtl-text jtl-text--secondary" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell jtl-table__cell--last">
                                <jtl:IconButton icon="close" size="24" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-row">
                        <jtl:ToolkitButton text-key="languages.addReplacement" icon="plus" compact="true" />
                    </ui:VisualElement>
                </jtl:Card>
                <jtl:Card title-key="languages.perConfiguration">
                    <ui:VisualElement class="jtl-table">
                        <ui:VisualElement class="jtl-table__row jtl-table__row--head">
                            <ui:VisualElement class="jtl-table__cell jtl-hstack-6" style="width: 190px;">
                                <jtl:PortalMark portal="yandex" size="20" />
                                <ui:Label text="Yandex Games" class="jtl-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell jtl-table__cell--grow jtl-table__cell--last jtl-row--wrap jtl-hstack-6">
                                <jtl:Badge text-key="language.English" variant="neutral" />
                                <jtl:Badge text-key="language.Russian" variant="neutral" />
                                <jtl:Badge text-key="language.Turkish" variant="neutral" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="jtl-table__row">
                            <ui:VisualElement class="jtl-table__cell jtl-hstack-6" style="width: 190px;">
                                <jtl:PortalMark portal="youtube" size="20" />
                                <ui:Label text="YouTube Playables" class="jtl-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="jtl-table__cell jtl-table__cell--grow jtl-table__cell--last jtl-row--wrap jtl-hstack-6">
                                <jtl:Badge text-key="language.English" variant="neutral" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </jtl:Card>
                <jtl:Card title-key="languages.playMode">
                    <jtl:FieldRow label-key="languages.startLanguage" label-width="150" note-key="languages.startLanguageNote">
                        <jtl:Dropdown choices-key="languages.startChoices" selected="1" width="220" />
                    </jtl:FieldRow>
                </jtl:Card>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
