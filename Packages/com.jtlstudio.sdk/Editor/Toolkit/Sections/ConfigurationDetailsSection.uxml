<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:jtl="JTLStudio.SDK.Editor.Toolkit.Components">
    <ui:VisualElement class="jtl-column jtl-vstack-16">
        <ui:VisualElement class="jtl-row jtl-hstack-12">
            <jtl:IconButton name="back-button" icon="chevron-left" variant="secondary" size="28" />
            <jtl:PortalMark portal="youtube" size="28" />
            <ui:VisualElement class="jtl-column">
                <ui:VisualElement class="jtl-row jtl-hstack-8">
                    <ui:Label text="YouTube Playables" class="jtl-section-header__title" />
                    <jtl:Badge text-key="badge.inactive" variant="neutral" />
                </ui:VisualElement>
                <jtl:LocalizedLabel key="details.portal" class="jtl-text--secondary" />
            </ui:VisualElement>
            <ui:VisualElement class="jtl-spacer" />
            <ui:VisualElement class="jtl-chip">
                <ui:Label text="JTLSDK_YOUTUBE_PLAYABLES" class="jtl-chip__text jtl-mono" />
                <jtl:IconButton icon="copy" size="20" />
            </ui:VisualElement>
            <jtl:ToolkitButton text-key="configurations.makeActive" variant="primary" />
        </ui:VisualElement>
        <jtl:Card title-key="details.projectSettings" caption-key="details.projectSettingsCaption" spacing="8">
            <ui:VisualElement class="jtl-column">
                <ui:VisualElement class="jtl-setting-head">
                    <jtl:LocalizedLabel key="details.columnSetting" class="jtl-table__heading jtl-setting-head__setting" />
                    <jtl:LocalizedLabel key="details.columnValue" class="jtl-table__heading jtl-setting-head__value" />
                    <ui:VisualElement class="jtl-spacer" />
                    <jtl:LocalizedLabel key="details.columnApply" class="jtl-table__heading jtl-setting-head__apply" />
                </ui:VisualElement>
                <ui:VisualElement class="jtl-setting-row">
                    <ui:Label text="WebGL Template" class="jtl-setting-row__name" />
                    <ui:VisualElement class="jtl-setting-row__value">
                        <jtl:Dropdown choices-key="details.templateChoices" selected="0" width="230" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-spacer" />
                    <ui:VisualElement class="jtl-setting-row__apply">
                        <jtl:Checkbox value="true" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="jtl-setting-row">
                    <ui:Label text="Compression Format" class="jtl-setting-row__name" />
                    <ui:VisualElement class="jtl-setting-row__value">
                        <jtl:Dropdown choices-key="details.compressionChoices" selected="0" width="230" error="true" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-spacer" />
                    <ui:VisualElement class="jtl-setting-row__apply">
                        <jtl:Checkbox value="true" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <jtl:InlineMessage text-key="details.compressionError" variant="error" class="jtl-setting-error" />
                <ui:VisualElement class="jtl-setting-row">
                    <ui:Label text="Decompression Fallback" class="jtl-setting-row__name" />
                    <ui:VisualElement class="jtl-setting-row__value">
                        <jtl:SwitchToggle value="false" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-spacer" />
                    <ui:VisualElement class="jtl-setting-row__apply">
                        <jtl:Checkbox value="true" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="jtl-setting-row">
                    <ui:Label text="Data Caching" class="jtl-setting-row__name" />
                    <ui:VisualElement class="jtl-setting-row__value">
                        <jtl:SwitchToggle value="true" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-spacer" />
                    <ui:VisualElement class="jtl-setting-row__apply">
                        <jtl:Checkbox value="true" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="jtl-setting-row">
                    <ui:Label text="Managed Stripping Level" class="jtl-setting-row__name" />
                    <ui:VisualElement class="jtl-setting-row__value">
                        <jtl:Dropdown choices-key="details.strippingChoices" selected="0" width="230" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-spacer" />
                    <ui:VisualElement class="jtl-setting-row__apply">
                        <jtl:Checkbox value="false" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="jtl-setting-row">
                    <ui:Label text="Run In Background" class="jtl-setting-row__name" />
                    <ui:VisualElement class="jtl-setting-row__value">
                        <jtl:SwitchToggle value="true" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-spacer" />
                    <ui:VisualElement class="jtl-setting-row__apply">
                        <jtl:Checkbox value="true" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="jtl-setting-row">
                    <ui:Label text="Memory Size" class="jtl-setting-row__name" />
                    <ui:VisualElement class="jtl-setting-row__value">
                        <jtl:NumberFieldWithUnit value="512" unit-key="unit.mb" width="120" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-spacer" />
                    <ui:VisualElement class="jtl-setting-row__apply">
                        <jtl:Checkbox value="true" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </jtl:Card>
        <jtl:Card title-key="details.modules" spacing="8">
            <ui:VisualElement class="jtl-column">
                <ui:VisualElement class="jtl-module-row jtl-module-row--dimmed">
                    <ui:VisualElement class="jtl-module-row__chevron">
                        <jtl:Icon icon="chevron-right" tone="muted" />
                    </ui:VisualElement>
                    <jtl:LocalizedLabel key="module.ads" class="jtl-module-row__name" />
                    <ui:VisualElement class="jtl-module-row__provider">
                        <jtl:Dropdown choices-key="details.unsupported" selected="0" width="230" disabled="true" />
                    </ui:VisualElement>
                    <jtl:LocalizedLabel key="details.noAds" class="jtl-module-row__note" />
                </ui:VisualElement>
                <ui:VisualElement class="jtl-module-row">
                    <ui:VisualElement class="jtl-module-row__chevron">
                        <jtl:Icon icon="chevron-up" tone="muted" />
                    </ui:VisualElement>
                    <jtl:LocalizedLabel key="module.saves" class="jtl-module-row__name" />
                    <ui:VisualElement class="jtl-module-row__provider">
                        <jtl:Dropdown choices-key="details.savesProvider" selected="0" width="230" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-module-row__note" />
                </ui:VisualElement>
                <ui:VisualElement class="jtl-module-fields jtl-vstack-8">
                    <jtl:FieldRow label-key="details.autosaveFocus" label-width="190">
                        <jtl:SwitchToggle value="true" />
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="details.flushPause" label-width="190">
                        <jtl:SwitchToggle value="true" />
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="details.localStorageKey" label-width="190">
                        <ui:TextField value="smashandhit.save" class="jtl-field" style="width: 240px;" />
                    </jtl:FieldRow>
                </ui:VisualElement>
                <ui:VisualElement class="jtl-module-row jtl-module-row--dimmed">
                    <ui:VisualElement class="jtl-module-row__chevron">
                        <jtl:Icon icon="chevron-right" tone="muted" />
                    </ui:VisualElement>
                    <jtl:LocalizedLabel key="module.purchases" class="jtl-module-row__name" />
                    <ui:VisualElement class="jtl-module-row__provider">
                        <jtl:Dropdown choices-key="details.unsupported" selected="0" width="230" disabled="true" />
                    </ui:VisualElement>
                    <jtl:LocalizedLabel key="details.noPayments" class="jtl-module-row__note" />
                </ui:VisualElement>
                <ui:VisualElement class="jtl-module-row">
                    <ui:VisualElement class="jtl-module-row__chevron">
                        <jtl:Icon icon="chevron-right" tone="muted" />
                    </ui:VisualElement>
                    <jtl:LocalizedLabel key="module.leaderboards" class="jtl-module-row__name" />
                    <ui:VisualElement class="jtl-module-row__provider">
                        <jtl:Dropdown choices-key="details.leaderboardsProvider" selected="0" width="230" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-module-row__note" />
                </ui:VisualElement>
            </ui:VisualElement>
        </jtl:Card>
    </ui:VisualElement>
</ui:UXML>
