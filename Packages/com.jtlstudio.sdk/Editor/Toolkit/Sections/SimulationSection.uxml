<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:jtl="JTLStudio.SDK.Editor.Toolkit.Components">
    <ui:VisualElement class="jtl-column jtl-vstack-16">
        <jtl:SectionHeader title-key="simulation.title" description-key="simulation.description">
            <jtl:LocalizedLabel key="simulation.overlay" class="jtl-text--secondary" />
            <jtl:SwitchToggle value="true" />
        </jtl:SectionHeader>
        <ui:VisualElement class="jtl-row jtl-row--start jtl-hstack-12">
            <ui:VisualElement class="jtl-column jtl-basis jtl-vstack-12">
                <jtl:Card title-key="simulation.playMode">
                    <jtl:FieldRow label-key="simulation.platform" label-width="180">
                        <ui:VisualElement class="jtl-field-box jtl-read-only" style="width: 260px;">
                            <jtl:PortalMark portal="yandex" size="16" />
                            <ui:Label text="Yandex Games" class="jtl-read-only__text" />
                            <jtl:Badge text-key="badge.active" variant="success" />
                        </ui:VisualElement>
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="simulation.device" label-width="180">
                        <jtl:Dropdown choices-key="simulation.devices" selected="0" width="200" />
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="simulation.initializationDelay" label-width="180">
                        <jtl:NumberFieldWithUnit value="0.5" unit-key="unit.seconds" />
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="simulation.simulateInitFailure" label-width="180">
                        <jtl:SwitchToggle value="false" />
                    </jtl:FieldRow>
                </jtl:Card>
                <jtl:Card title-key="simulation.ads">
                    <jtl:FieldRow label-key="simulation.behaviour" label-width="180">
                        <jtl:RadioGroup choices-key="simulation.behaviours" index="1" />
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="simulation.interstitial" label-width="180">
                        <jtl:Dropdown choices-key="simulation.interstitialResults" selected="0" width="200" />
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="simulation.rewarded" label-width="180">
                        <jtl:Dropdown choices-key="simulation.rewardedResults" selected="0" width="200" />
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="simulation.adDuration" label-width="180">
                        <jtl:NumberFieldWithUnit value="1.0" unit-key="unit.seconds" />
                    </jtl:FieldRow>
                </jtl:Card>
                <jtl:Card title-key="simulation.purchases">
                    <jtl:FieldRow label-key="simulation.behaviour" label-width="180">
                        <jtl:RadioGroup choices-key="simulation.behaviours" index="1" />
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="simulation.result" label-width="180">
                        <jtl:Dropdown choices-key="simulation.purchaseResults" selected="0" width="200" />
                    </jtl:FieldRow>
                </jtl:Card>
            </ui:VisualElement>
            <ui:VisualElement class="jtl-column jtl-basis jtl-vstack-12">
                <jtl:Card title-key="simulation.player">
                    <jtl:FieldRow label-key="simulation.authorized" label-width="180">
                        <jtl:SwitchToggle value="true" />
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="simulation.name" label-width="180">
                        <ui:TextField value="Test player" class="jtl-field" style="width: 200px;" />
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="simulation.id" label-width="180">
                        <ui:TextField value="editor-player" class="jtl-field" style="width: 200px;" />
                    </jtl:FieldRow>
                </jtl:Card>
                <jtl:Card title-key="simulation.saves">
                    <jtl:FieldRow label-key="simulation.simulateLoadFailure" label-width="180">
                        <jtl:SwitchToggle value="false" />
                    </jtl:FieldRow>
                    <jtl:FieldRow label-key="simulation.emptySave" label-width="180">
                        <jtl:SwitchToggle value="false" />
                    </jtl:FieldRow>
                </jtl:Card>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
