<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:jtl="JTLStudio.SDK.Editor.Toolkit.Components">
    <ui:VisualElement class="jtl-column jtl-vstack-16">
        <jtl:SectionHeader title-key="package.title" description-key="package.description" />
        <jtl:Card>
            <ui:VisualElement class="jtl-row jtl-hstack-14">
                <ui:VisualElement class="jtl-brand__logo jtl-brand__logo--package" />
                <jtl:LocalizedLabel key="package.sdkVersions" class="jtl-text--caption" />
                <ui:VisualElement class="jtl-spacer" />
                <jtl:Badge text-key="badge.updateAvailable" variant="accent" />
                <jtl:ToolkitButton text-key="package.releaseNotes" variant="ghost" trailing-icon="chevron-down" />
                <jtl:ToolkitButton text-key="package.updateTo" variant="primary" />
            </ui:VisualElement>
            <ui:VisualElement class="jtl-row jtl-hstack-10 jtl-pt-2">
                <jtl:Icon icon="chevron-up" tone="muted" />
                <jtl:LocalizedLabel key="package.showPreReleases" class="jtl-text--secondary" />
                <jtl:SwitchToggle value="false" />
            </ui:VisualElement>
            <ui:VisualElement class="jtl-column jtl-divider-top jtl-pt-4">
                <ui:VisualElement class="jtl-release">
                    <ui:VisualElement class="jtl-release__version">
                        <ui:Label text="1.1.0" class="jtl-text" />
                        <jtl:LocalizedLabel key="package.date110" class="jtl-text--caption jtl-mt-2" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-release__notes jtl-vstack-4">
                        <ui:VisualElement class="jtl-release__note">
                            <ui:Label text="•" class="jtl-release__bullet" />
                            <jtl:LocalizedLabel key="package.note110a" class="jtl-release__text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="jtl-release__note">
                            <ui:Label text="•" class="jtl-release__bullet" />
                            <jtl:LocalizedLabel key="package.note110b" class="jtl-release__text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="jtl-release__note">
                            <ui:Label text="•" class="jtl-release__bullet" />
                            <jtl:LocalizedLabel key="package.note110c" class="jtl-release__text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="jtl-release jtl-divider-top">
                    <ui:VisualElement class="jtl-release__version">
                        <ui:Label text="1.0.1" class="jtl-text" />
                        <jtl:LocalizedLabel key="package.date101" class="jtl-text--caption jtl-mt-2" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-release__notes jtl-vstack-4">
                        <ui:VisualElement class="jtl-release__note">
                            <ui:Label text="•" class="jtl-release__bullet" />
                            <jtl:LocalizedLabel key="package.note101a" class="jtl-release__text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="jtl-release__note">
                            <ui:Label text="•" class="jtl-release__bullet" />
                            <jtl:LocalizedLabel key="package.note101b" class="jtl-release__text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </jtl:Card>
        <jtl:Card>
            <ui:VisualElement class="jtl-row jtl-hstack-12">
                <jtl:Icon icon="template" size="20" />
                <ui:VisualElement class="jtl-column jtl-grow">
                    <ui:Label text="WebGL Template" class="jtl-text jtl-text--title" />
                    <jtl:LocalizedLabel key="package.templateVersions" class="jtl-text--caption" />
                </ui:VisualElement>
                <jtl:ToolkitButton name="template-update" text-key="package.update" />
            </ui:VisualElement>
        </jtl:Card>
        <jtl:Card title-key="package.modules">
            <ui:VisualElement class="jtl-table">
                <ui:VisualElement class="jtl-table__row jtl-table__row--head">
                    <ui:VisualElement class="jtl-table__cell jtl-hstack-6" style="width: 220px;">
                        <jtl:Icon icon="package" />
                        <ui:Label text="Yandex Metrica" class="jtl-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-table__cell" style="width: 80px;">
                        <ui:Label text="1.0.0" class="jtl-text--secondary" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-table__cell jtl-table__cell--grow">
                        <jtl:Badge text-key="badge.notInstalled" variant="neutral" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-table__cell jtl-table__cell--last" style="width: 90px;">
                        <jtl:ToolkitButton text-key="package.install" compact="true" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="jtl-table__row">
                    <ui:VisualElement class="jtl-table__cell jtl-hstack-6" style="width: 220px;">
                        <jtl:Icon icon="package" />
                        <ui:Label text="CrazyGames" class="jtl-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-table__cell" style="width: 80px;">
                        <ui:Label text="0.9.0" class="jtl-text--secondary" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-table__cell jtl-table__cell--grow">
                        <jtl:Badge text-key="badge.preRelease" variant="warning" />
                    </ui:VisualElement>
                    <ui:VisualElement class="jtl-table__cell jtl-table__cell--last" style="width: 90px;">
                        <jtl:ToolkitButton text-key="package.install" compact="true" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </jtl:Card>
        <ui:VisualElement class="jtl-row jtl-hstack-10">
            <jtl:LocalizedLabel key="package.checkedAt" class="jtl-text--caption" />
            <ui:VisualElement class="jtl-spacer" />
            <jtl:ToolkitButton text-key="package.checkNow" icon="refresh" variant="ghost" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
